{
 "id": "flick",
 "title": "Flick",
 "short": "Flick",
 "intro": {
  "dur": 4.5,
  "promise": "Supplier invoices **reconciled by agents, decided by people**: every line proved against contract, purchase order and meter data.",
  "pills": [
   {
    "t": "30–90 minutes per invoice",
    "c": "r"
   },
   {
    "t": "Quiet, costly mistakes",
    "c": "a"
   },
   {
    "t": "Proved, routed, released",
    "c": "g"
   }
  ],
  "foot": "Client: a pest-control multinational · illustrative screens · pilot figures"
 },
 "steps": [
  "Ask",
  "Gather",
  "Check",
  "Challenge",
  "Route",
  "Decide",
  "Re-test"
 ],
 "front": {
  "app": "Flick",
  "sub": "in Microsoft Teams · finance operations",
  "ic": "coin",
  "tabs": [
   "Chat",
   "Approvals",
   "Reports"
  ],
  "input": "Ask Flick about an invoice…"
 },
 "zone": "Runs in the client's Azure tenant · data stays in region",
 "tiles": [
  {
   "id": "mgr",
   "t": "Manager",
   "s": "plans and hands off",
   "ic": "route"
  },
  {
   "id": "spec",
   "t": "Agents",
   "s": "parse · match · spot · reconcile",
   "ic": "users"
  },
  {
   "id": "mcp",
   "t": "Data doors",
   "s": "MCP, one locked door per system",
   "ic": "plug"
  },
  {
   "id": "critic",
   "t": "Critic",
   "s": "a second AI vendor",
   "ic": "eye"
  },
  {
   "id": "route",
   "t": "Router",
   "s": "green · amber · red",
   "ic": "flag"
  },
  {
   "id": "ledger",
   "t": "Ledger",
   "s": "never posts twice",
   "ic": "db"
  }
 ],
 "scenes": [
  {
   "dur": 6,
   "step": 0,
   "lit": [
    "mgr"
   ],
   "cap": "An analyst asks in Teams. A **manager agent** hands the invoice to specialists, each with one job.",
   "chat": [
    {
     "k": "user",
     "t": "Reconcile this month's invoice from the utility supplier.",
     "at": 0.3
    },
    {
     "k": "file",
     "t": "Supplier invoice.pdf",
     "at": 0.9
    },
    {
     "k": "status",
     "t": "Reconciling",
     "at": 1.6,
     "until": 13
    }
   ],
   "work": {
    "type": "chain",
    "per": 5,
    "start": 1.0,
    "step": 0.7,
    "nodes": [
     {
      "t": "Parser",
      "s": "reads every line"
     },
     {
      "t": "Matcher",
      "s": "finds the evidence"
     },
     {
      "t": "Anomaly",
      "s": "spots variances"
     },
     {
      "t": "Reconciler",
      "s": "sets the route"
     },
     {
      "t": "Reporter",
      "s": "writes it up"
     }
    ],
    "notes": [
     {
      "t": "One job each, one clean handoff between",
      "x": 0,
      "y": 200,
      "at": 4.4
     }
    ]
   }
  },
  {
   "dur": 6.5,
   "step": 1,
   "lit": [
    "spec",
    "mcp"
   ],
   "cap": "Each specialist reaches only the system it needs, through **its own locked-down connection**.",
   "work": {
    "type": "hub",
    "center": {
     "t": "Manager",
     "s": "durable checkpoint",
