  "pills": [
   {
    "t": "Half a day of mapping",
    "c": "r"
   },
   {
    "t": "Chatbots invent prices",
    "c": "a"
   },
   {
    "t": "A comparison you can defend",
    "c": "g"
   }
  ],
  "foot": "Client: a homebuilder · illustrative quote lines · figures from real jobs and the test suites"
 },
 "steps": [
  "Upload",
  "Read",
  "Match",
  "Verify",
  "Calculate",
  "Resolve",
  "Share"
 ],
 "front": {
  "app": "Quote Intelligence",
  "sub": "web app · for sales consultants",
  "ic": "scale",
  "tabs": [
   "Compare",
   "Flags",
   "Exports"
  ],
  "input": "Ask to edit a row, e.g. add a rainwater tank…"
 },
